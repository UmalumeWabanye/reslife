generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  LANDLORD_OWNER
  LANDLORD_STAFF
  SUPER_ADMIN
}

enum FundingType {
  NSFAS
  BURSARY
  SELF
  PRIVATE_SPONSOR
}

enum ResidenceType {
  PRIVATE
  UNIVERSITY
  COMMUNAL
}

enum GenderPolicy {
  MIXED
  FEMALE_ONLY
  MALE_ONLY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
  ACCEPTED_BY_STUDENT
  DECLINED_BY_STUDENT
  WITHDRAWN
}

enum LeaseStatus {
  PENDING_MOVE_IN
  ACTIVE
  ENDED
  TERMINATED
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DocumentKind {
  ID_DOCUMENT
  PROOF_OF_REGISTRATION
  FUNDING_LETTER
  OTHER
}

// ─── Institutions & users ───────────────────────────────────────────────

model Institution {
  id           String   @id @default(cuid())
  name         String   @unique
  shortName    String
  emailDomains String[] // e.g. ["myuct.ac.za", "uct.ac.za"]
  city         String
  campuses     Campus[]
  students     StudentProfile[]
  residences   ResidenceInstitution[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Campus {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  latitude      Float
  longitude     Float

  @@unique([institutionId, name])
}

model User {
  id             String          @id @default(cuid())
  role           Role
  email          String          @unique
  phone          String?
  firstName      String?
  lastName       String?
  passwordHash   String? // landlords/admins only; students use OTP
  isActive       Boolean         @default(true)
  studentProfile StudentProfile?
  memberships    OrganisationMember[]
  refreshTokens  RefreshToken[]
  deviceTokens   DeviceToken[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model StudentProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  studentNumber String
  fundingType   FundingType?
  yearOfStudy   Int?
  gender        String?
  verifiedAt    DateTime?
  applications  Application[]
  leases        Lease[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([institutionId, studentNumber])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// ─── Landlords & residences ─────────────────────────────────────────────

model Organisation {
  id                 String               @id @default(cuid())
  name               String
  registrationNumber String?
  contactEmail       String
  contactPhone       String?
  status             VerificationStatus   @default(PENDING)
  members            OrganisationMember[]
  residences         Residence[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model OrganisationMember {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organisationId, userId])
}

model Residence {
  id              String                 @id @default(cuid())
  organisationId  String
  organisation    Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name            String
  slug            String                 @unique
  description     String
  type            ResidenceType
  genderPolicy    GenderPolicy           @default(MIXED)
  nsfasAccredited Boolean                @default(false)
  bursaryFunded   Boolean                @default(false)
  addressLine     String
  city            String
  latitude        Float
  longitude       Float
  amenities       String[]
  photos          String[]
  logoUrl         String?
  primaryColour   String                 @default("#2563EB")
  isPublished     Boolean                @default(false)
  institutions    ResidenceInstitution[]
  roomTypes       RoomType[]
  applications    Application[]
  announcements   Announcement[]
  maintenance     MaintenanceRequest[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([organisationId])
}

model ResidenceInstitution {
  residenceId   String
  residence     Residence   @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  distanceKm    Float?

  @@id([residenceId, institutionId])
}

model RoomType {
  id                String        @id @default(cuid())
  residenceId       String
  residence         Residence     @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  name              String // "Single en-suite", "2-sharing"
  occupancy         Int           @default(1)
  monthlyRentCents  Int
  depositCents      Int           @default(0)
  description       String?
  rooms             Room[]
  applications      Application[]
}

model Room {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  label      String // "B204"
  beds       Bed[]

  @@unique([roomTypeId, label])
}

model Bed {
  id     String  @id @default(cuid())
  roomId String
  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label  String // "A", "B"
  leases Lease[]

  @@unique([roomId, label])
}

// ─── Applications & leases ──────────────────────────────────────────────

model Application {
  id              String                @id @default(cuid())
  studentId       String
  student         StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  residenceId     String
  residence       Residence             @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  roomTypeId      String
  roomType        RoomType              @relation(fields: [roomTypeId], references: [id])
  academicYear    Int
  fundingType     FundingType
  motivation      String?
  status          ApplicationStatus     @default(DRAFT)
  reviewNote      String?
  submittedAt     DateTime?
  decidedAt       DateTime?
  documents       ApplicationDocument[]
  lease           Lease?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([studentId, residenceId, academicYear])
  @@index([residenceId, status])
}

model ApplicationDocument {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          DocumentKind
  fileKey       String
  fileName      String
  createdAt     DateTime     @default(now())
}

model Lease {
  id               String       @id @default(cuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id])
  bedId            String
  bed              Bed          @relation(fields: [bedId], references: [id])
  applicationId    String?      @unique
  application      Application? @relation(fields: [applicationId], references: [id])
  startDate        DateTime
  endDate          DateTime
  monthlyRentCents Int
  fundedBy         FundingType
  status           LeaseStatus  @default(PENDING_MOVE_IN)
  invoices         Invoice[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([studentId, status])
}

// ─── Residence life ─────────────────────────────────────────────────────

model Announcement {
  id          String             @id @default(cuid())
  residenceId String
  residence   Residence          @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  authorId    String
  title       String
  body        String
  pinned      Boolean            @default(false)
  publishedAt DateTime           @default(now())
  reads       AnnouncementRead[]

  @@index([residenceId, publishedAt])
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
}

model MaintenanceRequest {
  id           String               @id @default(cuid())
  residenceId  String
  residence    Residence            @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  leaseId      String
  reporterId   String
  assigneeId   String?
  category     String // plumbing, electrical, furniture, wifi, other
  title        String
  description  String
  location     String?
  photos       String[]
  priority     MaintenancePriority  @default(MEDIUM)
  status       MaintenanceStatus    @default(OPEN)
  resolvedAt   DateTime?
  comments     MaintenanceComment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([residenceId, status])
}

model MaintenanceComment {
  id        String             @id @default(cuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime           @default(now())
}

// ─── Billing ────────────────────────────────────────────────────────────

model Invoice {
  id          String        @id @default(cuid())
  leaseId     String
  lease       Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  period      String // "2026-02"
  amountCents Int
  paidCents   Int           @default(0)
  dueDate     DateTime
  status      InvoiceStatus @default(ISSUED)
  payments    Payment[]
  createdAt   DateTime      @default(now())

  @@unique([leaseId, period])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  provider    String        @default("paystack")
  reference   String        @unique
  amountCents Int
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  raw         Json?
  createdAt   DateTime      @default(now())
}

model PaymentWebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  type       String
  payload    Json
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

// ─── Platform ───────────────────────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String // "application.accept"
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
