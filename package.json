{
  "name": "students",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "first-run": "node scripts/first-run.mjs",
    "dev": "turbo run dev --filter=@students/api --filter=@students/web",
    "mobile": "pnpm --filter @students/mobile start",
    "phone-env": "node scripts/phone-env.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @students/e2e test",
    "db:up": "docker compose up -d --wait",
    "db:deploy": "pnpm --filter @students/db migrate:deploy",
    "db:migrate": "pnpm --filter @students/db migrate",
    "db:seed": "pnpm --filter @students/db seed",
    "db:studio": "pnpm --filter @students/db studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
